# Hunar Naqsha
PORT=3001
NODE_ENV=development

# Auth — change before any public deploy
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# AI (optional — heuristic works without). Prefer one of:
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash,gemini-1.5-flash,gemini-flash-latest

# Demo season
DEMO_DAYS_TO_EID=11
DEMO_FORCE_PRE_EID=true
AI_SCAN_MS=300000
BID_TTL_MS=259200000

# Security
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_MAX=400
CLIENT_DIST=

# Supabase (optional cloud mirror)
SUPABASE_URL=https://gnzxgxvzflkystgrcfbz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
